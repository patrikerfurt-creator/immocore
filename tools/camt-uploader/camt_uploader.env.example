# ============================================================================
#  IMMOCORE CAMT53-Uploader — Konfiguration
#  Diese Datei nach "camt_uploader.env" kopieren und anpassen.
#  (camt_uploader.env selbst gehört NICHT ins Git-Repo.)
# ============================================================================

# --- Lokaler Überwachungsordner ---------------------------------------------
# Ordner, in den die Bank-Software die camt.053-Dateien exportiert.
WATCH_FOLDER=C:\IMMOCORE\CamtUpload

# --- Server-Zugang (Strato) --------------------------------------------------
SSH_HOST=87.106.219.148
SSH_USER=patrik
SSH_KEY=C:\Users\maurer\.ssh\strato_server_key

# Zielordner auf dem Server — genau der Ordner, den `camt_watch` überwacht.
REMOTE_DIR=/home/patrik/immocore/CamtDAT

# --- Verhalten ---------------------------------------------------------------
# Prüfintervall in Sekunden (wie oft der Ordner erneut geprüft wird).
POLL_INTERVAL=60

# Sekunden, die eine Datei unverändert sein muss, bevor sie gesendet wird
# (verhindert Upload halb geschriebener Exporte).
STABLE_SECONDS=5

# Nur Dateien mit diesen Endungen berücksichtigen (kommagetrennt).
FILE_EXTENSIONS=.xml

# true = nur Dateien hochladen, deren Inhalt "camt.053" enthält.
VALIDATE_CAMT=true

# --- Optionale Pfade (leer lassen = sinnvolle Standardwerte) -----------------
# Merkliste der bereits hochgeladenen Dateien (SHA256).
# Standard: <WATCH_FOLDER>\.camt_uploader_state.json
STATE_FILE=

# known_hosts-Datei für die SSH-Verbindung.
# Standard: <Skriptordner>\known_hosts
KNOWN_HOSTS_FILE=

# Logdatei.  Standard: <Skriptordner>\logs\camt_uploader.log
LOG_FILE=
