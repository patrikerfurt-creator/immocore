# Uploads / temporäre Dateien
backend/media/
backend/staticfiles/

# Lokale DB-Snapshots (enthalten echte Personendaten — niemals ins Git!)
local_seed/*.sql
local_seed/*.sql.gz

# Betriebsdaten — echte Rechnungen, Bankauszuege und Importdateien gehoeren
# nicht ins Repository (enthalten Kontodaten und Personendaten).
/Rechnungen/
/CamtDAT/
/Testdateine IMPORT/

# Celery-Laufzeitstand (wird beim Start neu erzeugt)
backend/celerybeat-schedule

# Lokale DB-Dumps: die bestehende Regel greift nur eine Ebene tief und
# erfasst 'local_seed/live_backup/*.sql.gz' nicht — dort liegen echte
# Live-Daten (Personen, Bankverbindungen), die nie ins Repo gehören.
local_seed/**/*.sql
local_seed/**/*.sql.gz
