SECRET_KEY=your-secret-key-here
DEBUG=True
DB_NAME=immocore
DB_USER=immocore
DB_PASSWORD=immocore
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=your-anthropic-api-key
ALLOWED_HOSTS=localhost,127.0.0.1

# E-Mail (Default: Konsolen-Backend, es wird lokal nichts versendet)
# ACHTUNG Produktionsserver: EMAIL_BACKEND und EMAIL_HOST MÜSSEN gesetzt sein.
# Bleibt es beim Konsolen-Backend oder fehlt EMAIL_HOST, verweigert der
# Handwerkerauftrag-Versand (apps.handwerker.tasks) bei DEBUG=False bewusst
# den Versand, statt Aufträge fälschlich als "versendet" zu markieren.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=info@demme-immobilien.de
RECHNUNG_EMPFANG_EMAIL=rechnungen@demme-immobilien.de
FRONTEND_BASE_URL=http://localhost:3000
