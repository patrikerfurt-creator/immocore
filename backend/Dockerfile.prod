FROM python:3.11-slim

# WeasyPrint System-Abhängigkeiten + OCR (Tesseract, poppler für pdf2image)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    tesseract-ocr \
    tesseract-ocr-deu \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN python manage.py collectstatic --noinput || true

# ---------------------------------------------------------------------------
# Non-root-Betrieb (Sicherheit + korrekte Datei-Ownership im Rechnungen-Ordner)
# ---------------------------------------------------------------------------
# uid 1000 = Host-User "patrik" (Eigentümer des gemounteten Rechnungen-Ordners).
# gid 1001 = Host-Gruppe "rechnung" — nötig, damit der Container die vom
# chroot-Uploader (uid 1001) abgelegten Dateien gruppenlesbar lesen/verschieben
# kann. Die konkreten uid/gid müssen zur Host-Umgebung passen und werden in
# docker-compose.prod.yml zusätzlich explizit via user:/group_add gepinnt.
RUN groupadd -g 1000 appuser \
    && useradd -u 1000 -g 1000 -m -s /bin/bash appuser \
    && groupadd -g 1001 rechnung \
    && usermod -aG rechnung appuser \
    && mkdir -p /app/media /app/staticfiles /app/sepa_output /app/sepa_archive \
    && chown -R appuser:appuser /app

USER appuser

EXPOSE 8000

CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "120"]
